{% extends 'base.html.twig' %}

{% block title %}Gérer les Avis - Admin{% endblock %}

{% block body %}
<div class="container" style="margin-top: 40px;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h1 class="mb-4">Gérer les Avis</h1>
        <a href="{{ path('admin_dashboard') }}" class="btn" style="text-decoration: none; color: var(--color-primary);">&larr; Retour au Tableau de Bord</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" style="background: #d4edda; color: #155724; padding: 10px; border-radius: 4px; margin-bottom: 20px;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card" style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="text-align: left; border-bottom: 2px solid #eee;">
                    <th style="padding: 10px;">Date</th>
                    <th style="padding: 10px;">Client</th>
                    <th style="padding: 10px;">Note</th>
                    <th style="padding: 10px; width: 40%;">Commentaire</th>
                    <th style="padding: 10px;">Statut</th>
                    <th style="padding: 10px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for review in reviews %}
                <tr style="border-bottom: 1px solid #f9f9f9;">
                    <td style="padding: 10px;">{{ review.createdAt|date('Y-m-d') }}</td>
                    <td style="padding: 10px;">{{ review.customerName }}</td>
                    <td style="padding: 10px; color: #f39c12;">
                        {% for i in 1..5 %}
                            {% if i <= review.rating %}★{% else %}☆{% endif %}
                        {% endfor %}
                    </td>
                    <td style="padding: 10px;">{{ review.comment }}</td>
                    <td style="padding: 10px;">
                        {% if review.isVisible %}
                            <span style="background: #e8f5e9; color: #2e7d32; padding: 2px 8px; border-radius: 10px; font-size: 0.85em;">Visible</span>
                        {% else %}
                            <span style="background: #f8d7da; color: #721c24; padding: 2px 8px; border-radius: 10px; font-size: 0.85em;">Masqué</span>
                        {% endif %}
                    </td>
                    <td style="padding: 10px;">
                        <a href="{{ path('admin_review_toggle', {'id': review.id}) }}" 
                           style="margin-right: 10px; color: var(--color-primary); text-decoration: none; font-weight: 500;">
                            {% if review.isVisible %}Masquer{% else %}Approuver{% endif %}
                        </a>
                        <a href="{{ path('admin_review_delete', {'id': review.id}) }}" 
                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet avis ?');"
                           style="color: #dc3545; text-decoration: none; font-size: 0.9em;">
                            Supprimer
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" style="padding: 20px; text-align: center;">Aucun avis trouvé.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
